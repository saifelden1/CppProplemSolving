#include <iostream>

int main() {
    // Fast I/O
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(NULL);

    // Use long long to prevent overflow during multiplication
    long long a, b, c, d;
    std::cin >> a >> b >> c >> d;

    // Check all 6 possible permutations of +, -, *
    if (a + b - c == d) {
        std::cout << "YES\n";
    } else if (a + b * c == d) {
        std::cout << "YES\n";
    } else if (a - b + c == d) {
        std::cout << "YES\n";
    } else if (a - b * c == d) {
        std::cout << "YES\n";
    } else if (a * b + c == d) {
        std::cout << "YES\n";
    } else if (a * b - c == d) {
        std::cout << "YES\n";
    } else {
        std::cout << "NO\n";
    }

    return 0;
}